+package session
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+)
+
+// PairPhone links a session by phone number instead of QR: it starts a fresh pairing
+// (same as Pair), waits for the login websocket to be up, then asks WhatsApp for an
+// 8-character linking code. The user enters it on the phone under
+// Linked devices > Link with phone number instead. Completion arrives through the same
+// QR-channel "success" event, so the session flips to paired exactly as with a QR scan.
+// Added by wake-agent (services/wacalls/patches/0001-pair-phone.patch).
+func (m *Manager) PairPhone(ctx context.Context, id, phone string) (string, error) {
+	if err := m.Pair(id); err != nil {
+		return "", err
+	}
+	s, ok := m.Get(id)
+	if !ok {
+		return "", fmt.Errorf("no session %s", id)
+	}
+	deadline := time.Now().Add(15 * time.Second)
+	for time.Now().Before(deadline) {
+		s.mu.Lock()
+		state := s.auth.State
+		s.mu.Unlock()
+		if state == "qr" {
+			break
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+	return s.client.PairPhone(ctx, phone, true, whatsmeow.PairClientChrome, "Chrome (Linux)")
+}
