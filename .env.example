# Copy to .env (gitignored, chmod 600). Never commit real values.

# --- NVIDIA (ASR + TTS + the default LLM): https://build.nvidia.com -> API key
NVIDIA_API_KEY=nvapi-...
# NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# RIVA_SERVER=grpc.nvcf.nvidia.com:443
# RIVA_ASR_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081              # parakeet 1.1b en-US streaming
# RIVA_ASR_MULTILINGUAL_FUNCTION_ID=71203149-d3b7-4460-8231-1be2543a1fca # parakeet rnnt multilingual (hi-IN, multi)
# RIVA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969              # magpie-tts-multilingual

# --- Gemini Live (optional second voice provider: native speech-to-speech, used by --live)
# https://aistudio.google.com -> API key. Leave empty to stay on the NVIDIA cascade only.
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- WaCalls (WhatsApp VoIP sidecar), loopback only. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
WACALLS_URL=http://127.0.0.1:8787
WACALLS_ADMIN_USER=admin
WACALLS_ADMIN_PASSWORD=change-me
WACALLS_API_TOKEN=change-me-long-random
# WACALLS_SESSION_ID=              # optional: pin a specific paired session

# --- WakeAgent local API (127.0.0.1:8790), bearer token required
WAKE_API_TOKEN=change-me-long-random
# WAKE_HOME=~/.wake-agent          # runtime data: wacalls.db, wake.db, logs (outside the repo)
